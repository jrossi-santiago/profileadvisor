# --- Phase 1+ : tweet ingest -------------------------------------------------
# GetXAPI key used to read PUBLIC profiles and tweets.
GETXAPI_KEY=

# --- Phase 1+ : chat model ---------------------------------------------------
# xAI Grok (OpenAI-compatible chat completions) is the default chat provider.
XAI_API_KEY=
# Optional fallback provider if XAI_API_KEY is absent.
OPENAI_API_KEY=

# --- Phase 2.5+ : optional judgments ----------------------------------------
# TypeSafe Jev. Leave blank to run with PERSONA_JUDGE=off.
TYPESAFE_AI_API_KEY=

# --- Phase 1+ : storage (Drizzle + Postgres) --------------------------------
# Runtime connection, used by the app. On Supabase this is the TRANSACTION
# pooler (port 6543) — it is IPv4 and returns connections per statement, which
# is what short-lived serverless invocations need. Drizzle's postgres.js driver
# must be created with { prepare: false } against it.
#   postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migration connection, used by drizzle-kit only. On Supabase this is the
# SESSION pooler (port 5432) or the direct connection if your network can reach
# it. drizzle-kit runs DDL in transactions and needs prepared statements, so it
# cannot use the transaction pooler above.
#   postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Local Postgres: set both to postgres://postgres:postgres@localhost:5432/talkto
DIRECT_DATABASE_URL=

# --- Phase 1+ : tweet ingest -------------------------------------------------
# GetXAPI key used to read PUBLIC profiles and tweets. https://docs.getxapi.com
# Billed per call ($0.001); one ingest costs 1 profile call + N timeline pages.
GETXAPI_KEY=
# Override only if you are pointing at a proxy or a mock server.
GETXAPI_BASE_URL=https://api.getxapi.com
# Usable tweets to collect per ingest, across the main timeline and the replies
# tab combined. BUILD.md's target range is 300-500.
X_TWEET_CAP=400
# Hard stop on timeline pages across both timelines, so a huge account cannot
# run up a bill. At ~20 posts per page, 25 pages is ~500 posts and $0.025.
X_MAX_PAGES=25
# Read the replies tab as well as the main timeline. Argument style is mostly
# invisible in originals alone, so this defaults on.
X_INCLUDE_REPLIES=true

# --- Phase 1+ : chat model ---------------------------------------------------
# xAI Grok is the default provider. If XAI_API_KEY is absent the app falls back
# to OPENAI_API_KEY; if both are absent, chat returns a 503 with a clear message.
XAI_API_KEY=
# Set these to model ids your account actually has access to.
XAI_CHAT_MODEL=grok-4
XAI_COMPILE_MODEL=grok-4-fast
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_COMPILE_MODEL=gpt-4.1-mini
# Newest posts stuffed into each chat prompt when retrieval is unavailable.
CHAT_RECENT_TWEETS=40

# --- Phase 3 : embeddings + retrieval ---------------------------------------
# Embeddings are resolved separately from chat: xAI does not publish an
# embeddings endpoint, so this falls back to OPENAI_API_KEY. With neither set,
# retrieval degrades to recency-only and chat still works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column width in the schema. Changing it needs a
# migration and a full re-embed, not just an env change.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96

# Semantic matches pulled per question.
RETRIEVAL_K=12
# Newest posts always included as current context, whatever the question.
RETRIEVAL_RECENT_N=30
# score = semantic + lambda * exp(-ageDays / halfLife). Raise lambda to favour
# recent posts harder; 0 disables the recency bonus entirely.
RETRIEVAL_LAMBDA=0.25
RETRIEVAL_HALF_LIFE_DAYS=45
# Flat bonus when a post mentions a topic the card already knows about.
RETRIEVAL_KEYWORD_BOOST=0.05

# --- Phase 2.5+ : optional judgments ----------------------------------------
# TypeSafe Jev. Leave blank to run with PERSONA_JUDGE=off.
TYPESAFE_AI_API_KEY=

# --- Phase 1+ : storage (Drizzle + Postgres) --------------------------------
# Runtime connection, used by the app. On Supabase this is the TRANSACTION
# pooler (port 6543) — it is IPv4 and returns connections per statement, which
# is what short-lived serverless invocations need. The postgres.js client is
# created with { prepare: false } for exactly this reason.
#   postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migration connection, used by drizzle-kit only. On Supabase this is the
# SESSION pooler (port 5432) or the direct connection if your network can reach
# it. drizzle-kit runs DDL in transactions and needs prepared statements, so it
# cannot use the transaction pooler above.
#   postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Local Postgres: set both to postgres://postgres:postgres@localhost:5432/talkto
DIRECT_DATABASE_URL=
DATABASE_POOL_MAX=5
